  "characters": [
    {
      "id": "brynn",
      "label": "Brynn",
      "role": "Alaha guard trainee · Princess of Maile · leader of the rebellion",
      "type": "heir",
      "affil": "rebellion",
      "region": "kenta",
      "book": 1,
      "lastBook": 1,
      "status": "alive",
      "size": "main",
      "x": 460,
      "y": 60,
      "statusDetail": "fugitive",
      "aliases": [
        "Jovie",
        "Jovinnia",
        "Princess of Maile"
      ],
      "magic": "Light wielding — the first in millennia",
      "bioByBook": [
        {
          "book": 1,
          "text": "Raised on Urchin Row as an orphan of the Alaha, copper-haired among a fair-haired people, and a guard trainee alongside Kai and Messer. Her magic is dormant only because she has never touched land. She is Jovinnia, Princess of Maile, whom Captain Wren abducted as a child — and she remembered it the whole time. The escape from Alaha, the helplessness Acker believed, and Kai's visible influence over her were all her design. She awakens in Roison as the first light wielder in millennia, burns the Dark Forest away, and takes the Kenta court by poison before fleeing the palace."
        }
      ]
    },
    {
      "id": "acker",
      "label": "Acker",
      "role": "Prince of Kenta",
      "type": "heir",
      "affil": "kenta_crown",
      "region": "kenta",
      "book": 1,
      "lastBook": 1,
      "status": "alive",
      "size": "main",
      "x": 570,
      "y": 60,
      "aliases": [
        "The Metal Slinger",
        "Soldier of Chaos"
      ],
      "magic": "Elemental — metal",
      "bioByBook": [
        {
          "book": 1,
          "text": "The Metal Slinger, the Soldier of Chaos, and — unknown to Brynn for a third of the book — the prince of Kenta. He has been searching for the lost princess of Maile for fifteen years under a blood oath that limits what he can say. He surrenders himself at the Alaha dock deliberately, kills Commander Dupre in the escape, and crosses an ocean and a cursed forest with her. He declares her his match before the Kenta court against his father and his betrothal to Strou, and is collared with mangi stone at the coup."
        }
      ]
    },
    {
      "id": "kai",
      "label": "Kai",
      "role": "Heir to the Alaha · Brynn's betrothed",
      "type": "heir",
      "affil": "rebellion",
      "region": "alaha",
      "book": 1,
      "lastBook": 1,
      "status": "alive",
      "size": "main",
      "x": 285,
      "y": 55,
      "magic": "Influence — amplifies emotion through touch",
      "bioByBook": [
        {
          "book": 1,
          "text": "Captain Wren's son and heir, a guard trainee, and Brynn's lifelong protector. He inherited his father's gift of influence and has been amplifying Brynn's feelings toward him through touch for years — at her instruction, so that Acker would believe her a manipulated innocent. He and Brynn conspired to depose both Edmond of Kenta and his own father."
        }
      ]
    },
    {
      "id": "messer",
      "label": "Messer",
      "role": "Commander of the Alaha guard",
      "type": "shifter",
      "affil": "rebellion",
      "region": "kenta",
      "book": 1,
      "lastBook": 1,
      "status": "alive",
      "size": "main",
      "x": 680,
      "y": 60,
      "aliases": [
        "Blue"
      ],
      "magic": "Shifting — eyun, giant squid, leopard",
      "bioByBook": [
        {
          "book": 1,
          "text": "A guard trainee named commander at graduation, abused by his father Johannes, arranged-matched to Aurora and in love with Masie. He is a shifter, and he is Blue: the midnight-blue eyun that finds Brynn and Acker at sea followed her across the entire ocean in bird form. He fights Sven into the Dark Forest, is branded by Acker with a hearthstone scar, and flees the Kenta palace with Brynn."
        }
      ]
    },
    {
      "id": "wren",
      "label": "Captain Wren",
      "role": "Leader of the Alaha",
      "type": "heir",
      "affil": "alaha",
      "region": "alaha",
      "book": 1,
      "lastBook": 1,
      "status": "alive",
      "size": "main",
      "x": 70,
      "y": 55,
      "magic": "Influence; over three centuries old",
      "bioByBook": [
        {
          "book": 1,
          "text": "Leader of the Alaha, over three centuries old, and an Heir whose gift is influence — the reason the Alaha were exiled. He abducted Jovinnia of Maile as a child, raised her as Brynn, and bound Acker under a blood oath to keep him silent about her. He shields her from Kenta by betrothing her to his son, and intends to let Acker drown in the flooding brig."
        }
      ]
    },
    {
      "id": "faline",
      "label": "Faline",
      "role": "Wren's wife · Kai's mother",
      "type": "no_gift",
      "affil": "alaha",
      "region": "alaha",
      "book": 1,
      "lastBook": 1,
      "status": "alive",
      "size": "side",
      "x": 180,
      "y": 55,
      "bioByBook": [
        {
          "book": 1,
          "text": "Wren's wife and Kai's mother, and the closest thing Brynn has to a mother in Alaha."
        }
      ]
    },
    {
      "id": "edmond",
      "label": "King Edmond",
      "role": "King of Kenta",
      "type": "heir",
      "affil": "kenta_crown",
      "region": "kenta",
      "book": 1,
      "lastBook": 1,
      "status": "alive",
      "size": "main",
      "x": 460,
      "y": 132,
      "statusDetail": "magic severed",
      "magic": "Recorded as fire — he behaves as though it is influence",
      "bioByBook": [
        {
          "book": 1,
          "text": "King of Kenta and Acker's father. He forces Brynn to kneel at court and presses Acker to keep her as a consort while marrying Irina for Strou's army. The Kenta archives record his gift as fire, not the influence he appears to wield — a discrepancy the book raises and does not answer. Brynn severs his magic with the hearthstone dagger and spares his life at Acker's request."
        }
      ]
    },
    {
      "id": "beau",
      "label": "Beau",
      "role": "Third in command of Kenta",
      "type": "heir",
      "affil": "rebellion",
      "region": "kenta",
      "book": 1,
      "lastBook": 1,
      "status": "alive",
      "size": "main",
      "x": 570,
      "y": 132,
      "magic": "Aura reading",
      "bioByBook": [
        {
          "book": 1,
          "text": "Third in command of Kenta, Acker's half-sister, and an Heir who reads emotional auras. She confirms that Brynn and Acker are matched and vouches for Messer's loyalty. She has joined Brynn's rebellion, which is revealed only when she binds her own half-brother at the coup."
        }
      ]
    },
