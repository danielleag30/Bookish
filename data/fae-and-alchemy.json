  "events": [
    {
      "book": 1,
      "text": "Zilvaren is a harsh desert city on a human world, ruled by Madra, an immortal queen",
      "involves": [
        "madra"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Saeris Fane is a thief in Zilvaren who hides that she can manipulate metal — an alchemist",
      "involves": [
        "saeris_fane"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Hayden Fane, Saeris's younger brother, works as a store clerk in the seventh ward",
      "involves": [
        "saeris_fane",
        "hayden_fane"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Iris Fane, their mother, is dead before the story opens",
      "involves": [
        "iris_fane"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Saeris scavenges the Undercroft for water and finds an enchanted Fae gauntlet",
      "involves": [
        "saeris_fane"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "The gauntlet opens a portal and pulls Saeris into Yvelia, the frozen Fae realm",
      "involves": [
        "saeris_fane"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Carrion Swift, a smuggler and gambler from Zilvaren, is pulled through with her",
      "involves": [
        "carrion_swift"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Saeris meets Kingfisher, a Fae warrior over 1,700 years old, Lord of Cahlish",
      "involves": [
        "saeris_fane",
        "kingfisher"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Kingfisher has been corrupted by long exposure to quicksilver",
      "involves": [
        "kingfisher"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Everlayne is Kingfisher's half-sister and a daughter of King Belikon",
      "involves": [
        "kingfisher",
        "everlayne",
        "belikon_de_barra"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Everlayne welcomes Saeris to the court at Cahlish, a fiefdom warded against Belikon",
      "involves": [
        "saeris_fane",
        "everlayne",
        "belikon_de_barra"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Te Léna is a healer at Cahlish who explains Fae customs and mating bonds to Saeris",
      "involves": [
        "saeris_fane",
        "te_lena"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Renfis Orithian commands the Yvelian army and is a friend to Kingfisher",
      "involves": [
        "kingfisher",
        "renfis_orithian"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Lorreth is a Fae warrior and bard who fights alongside Kingfisher",
      "involves": [
        "kingfisher",
        "lorreth"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Belikon De Barra rules Yvelia as king from the Winter Palace",
      "involves": [
        "belikon_de_barra"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Saeris is revealed to be a quicksilver alchemist, the first in generations",
      "involves": [
        "saeris_fane"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Kingfisher needs an alchemist to reforge Fae weapons against the vampires of Sanasroth",
      "involves": [
        "kingfisher"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Malcolm is the vampire king of Sanasroth, a former Fae who took on the blood curse",
      "involves": [
        "malcolm"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Belikon is revealed to have secretly allied with Malcolm for millennia, feeding his horde",
      "involves": [
        "belikon_de_barra",
        "malcolm"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Lupo Proelia is the rebellion opposing Belikon; Danya, Korrix, Foley, Merelle and Vashgidyan fight in it",
      "involves": [
        "belikon_de_barra",
        "danya",
        "korrix",
        "foley",
        "merelle",
        "vashgidyan"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Saeris and Kingfisher move from open hostility to a reluctant alliance",
      "involves": [
        "saeris_fane",
        "kingfisher"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Carrion Swift is revealed to be Carrion Daianthus, heir to the Yvelian throne",
      "involves": [
        "carrion_swift"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Finran, Kingfisher's father, carried the infant Carrion to Zilvaren a thousand years ago to hide him from the usurper Belikon, glamouring his ears and canines so he would pass as human",
      "involves": [
        "carrion_swift",
        "kingfisher",
        "belikon_de_barra",
        "finran"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Rurik and Amelia Daianthus were the former king and queen of Yvelia, of Carrion's line",
      "involves": [
        "carrion_swift",
        "rurik_daianthus",
        "amelia_daianthus"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Carrion's bloodline created the curse that made Malcolm a vampire, so no vampire can drink from him or enthrall him",
      "involves": [
        "carrion_swift",
        "malcolm"
      ],
      "kind": "other"
    },
    {
      "book": 1,
      "text": "Onyx is a fox who attaches himself to the group",
      "involves": [
        "onyx"
      ],
      "kind": "other"
    },
    {
